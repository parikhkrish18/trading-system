<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trading-system.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kp/Downloads/trading-system/.venv/bin/streamlit</string>
        <string>run</string>
        <string>monitoring/dashboard/app.py</string>
        <string>--server.headless</string>
        <string>true</string>
        <string>--server.port</string>
        <string>8501</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kp/Downloads/trading-system</string>

    <!-- Streamlit runs the target script with its own directory on
         sys.path, not the working directory, so `from data.ingest...`
         imports fail without this — hit live, not hypothetical. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/kp/Downloads/trading-system</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/kp/Downloads/trading-system/logs/dashboard.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kp/Downloads/trading-system/logs/dashboard.error.log</string>

    <!-- Unlike the weekly cycle, this should just always be up. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
