<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trading-system.weekly-cycle</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kp/Downloads/trading-system/.venv/bin/python</string>
        <string>-m</string>
        <string>scripts.run_weekly_cycle</string>
        <string>--feature-set-id</string>
        <string>v4</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kp/Downloads/trading-system</string>

    <key>StandardOutPath</key>
    <string>/Users/kp/Downloads/trading-system/logs/weekly-cycle.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kp/Downloads/trading-system/logs/weekly-cycle.error.log</string>

    <!--
      Monday 13:30 IST = 08:00 UTC = 4:00am ET (summer) / 3:00am ET
      (winter). Same-day-as-open, not the day before: this trades off some
      of the safety margin a Sunday run would have for the ability to pick
      up news that broke overnight/premarket Monday. The pipeline this
      launches (universe refresh, price/fundamentals/news ingestion --
      fundamentals+news alone run "roughly two hours" on Polygon's free
      tier, per scripts/run_weekly_cycle.py's own docstring -- sentiment
      scoring, feature build, then the actual screen-and-trade cycle) is
      genuinely multi-hour, so this leaves 5.5-6.5 hours before the
      9:30am ET open depending on the season -- comfortable for a normal
      run, not the ~day of slack an earlier Sunday schedule would have.
      If it's still running at 9:30am ET, nothing is lost: broker order
      submission checks the market clock per-order, not once at the start,
      so a slow cycle just places its remaining orders as regular live
      market orders during the session instead of premarket DAY orders --
      later than the open, but still that Monday, still automatic (no
      human approval needed either way -- see APPROVAL_MODE in
      config/settings.py). IST has no DST of its own, so this drifts by
      up to ~1hr of IST clock time across US DST transitions (second
      Sunday in March / first Sunday in November); that's expected, not a
      bug -- the buffer above absorbs it.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
