<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trading-system.weekly-cycle</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kp/Downloads/trading-system/.venv/bin/python</string>
        <string>-m</string>
        <string>scripts.run_weekly_cycle</string>
        <string>--feature-set-id</string>
        <string>v3</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kp/Downloads/trading-system</string>

    <key>StandardOutPath</key>
    <string>/Users/kp/Downloads/trading-system/logs/weekly-cycle.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kp/Downloads/trading-system/logs/weekly-cycle.error.log</string>

    <!--
      Monday 19:30 IST. US market open (9:30am ET) sits at 19:00-20:00 IST
      depending on US daylight saving (IST itself has no DST) — this is a
      fixed midpoint, off by up to ~30min either side of open across the
      year. Fine for a weekly/biweekly, non-intraday rebalance; nudge Hour
      by +/-1 around US DST transitions (second Sunday in March / first
      Sunday in November) if you want it tighter to the open.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
