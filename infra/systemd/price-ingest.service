[Unit]
Description=Daily price ingestion for trading-system
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/trading-system
EnvironmentFile=/opt/trading-system/.env
ExecStart=/opt/trading-system/.venv/bin/python -m data.ingest.prices --symbols SPY,QQQ,TQQQ,SQQQ --source alpaca
