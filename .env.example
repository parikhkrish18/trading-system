# --- Broker selection ---
# ibkr  = Interactive Brokers via locally running TWS / IB Gateway (recommended)
# alpaca = Alpaca REST API (needs keys below)
BROKER=ibkr

# Which trading environment to use. NEVER default to live.
TRADING_MODE=paper

# Outside RTH, market orders aren't accepted at all — when true,
# execution/broker_alpaca.py switches to limit orders automatically.
# IBKR (execution/broker_ibkr.py) doesn't support this yet.
# Default false: approval latency + thin extended-hours quotes interact
# badly — turn on deliberately if you want it.
ALLOW_EXTENDED_HOURS_TRADING=false

# --- IBKR (TWS / IB Gateway) ---
# No API keys — log in to TWS/Gateway and enable socket API access.
# Ports match Blue_Chip_Trading_Bot/tws_bot.py:
#   TWS paper 7497 | TWS live 7496
#   IBG paper 4002 | IBG live 4001
IBKR_HOST=127.0.0.1
IBKR_CLIENT_ID=1
IBKR_LIVE_CLIENT_ID=2
IBKR_PAPER_PORT=7497
IBKR_LIVE_PORT=7496

# --- Broker (Alpaca) — only needed when BROKER=alpaca ---
# Keep paper and live keys in clearly separate variables so a bug can't
# fire a live order during a paper test (see Security section of the plan).
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# --- Market data vendor(s) ---
# Alpaca's own market data feed works out of the box with the keys above.
# Set these if you're using a separate consolidated-tape / fundamentals+news
# vendor (e.g. Polygon). Used by data/ingest/fundamentals.py and
# data/ingest/news.py.
POLYGON_API_KEY=
FUNDAMENTALS_NEWS_API_KEY=

# --- LLM (used by features/qualitative/sentiment.py for headline scoring) ---
ANTHROPIC_API_KEY=

# --- FRED (CPI/Jobs release dates for data/ingest/macro_calendar.py) ---
# Free instant key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Database (TimescaleDB via docker-compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=trading
DB_PASSWORD=change_me_locally

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Dashboard ---
# One shared password gates the whole dashboard — the page itself, every
# /api read, and the manual-trigger buttons alike. Enter it once at /login;
# the session cookie that sets covers everything else until it's cleared
# (via the "Log out" link) or this password changes, which invalidates
# every outstanding cookie at once. Blank is fine on localhost — the
# dashboard then only serves on a loopback bind; required (and enforced
# even on loopback once set) when DASHBOARD_HOST is non-loopback.
DASHBOARD_PASSWORD=
# Loopback by default; the Docker image sets 0.0.0.0 itself.
DASHBOARD_HOST=127.0.0.1
# Which port to bind. Leave unset locally (defaults to 8501). Do NOT set it
# on a platform host — Railway and friends inject PORT themselves and route
# the public domain to whatever they chose; overriding it points the health
# check at a dead port. See infra/railway/README.md.
# PORT=8501

# --- Alerts ---
SLACK_WEBHOOK_URL=

# --- Trade approval (Telegram) ---
# Bot that sends numbered trade proposals to your phone and reads back
# "approve 1" / "reject 2" style replies. Blank token in telegram mode
# fails closed: every proposal is rejected and a Slack alert fires.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# telegram = human approves each open/close | auto = old unattended behavior
APPROVAL_MODE=telegram
# Seconds to wait for replies (keep under 3600 — the hourly monitor shares the bot)
APPROVAL_TIMEOUT_S=900
# Unanswered *close* proposals at timeout: reject (default) or approve.
# Closes are risk-reducing, so approve-on-timeout is a defensible choice.
APPROVAL_TIMEOUT_CLOSE_ACTION=reject

# --- Per-pick exit levels (execution/exit_levels.py) ---
# Each pick gets its own take-profit and stop-loss, derived from what the
# model predicted for it and how far that stock normally moves — one pair
# of numbers cannot be right for a utility and a biotech at once. The
# HOLD_* settings above are the fallback, used only when a stock's
# volatility can't be measured.
#
# Take profit is the predicted move, floored so it is worth the round trip
# and capped at this many horizon-sigmas so an extreme forecast doesn't set
# a target the stock has no history of reaching.
EXIT_TAKE_PROFIT_MAX_SIGMAS=2.0
EXIT_MIN_TAKE_PROFIT_PCT=0.03
# Stop loss in horizon-sigmas. 1.5 rather than 1.0: at one sigma roughly a
# third of positions are stopped out by ordinary wandering before a
# multi-week thesis has had time to be right or wrong.
EXIT_STOP_LOSS_SIGMAS=1.5
# Bounds — volatility is estimated from a short window and can be badly
# wrong right after a gap. Without these, one quiet month sets a 1% stop.
EXIT_MIN_STOP_LOSS_PCT=0.05
EXIT_MAX_STOP_LOSS_PCT=0.20

# --- Between-cycle emergency brake (execution/contradiction_monitor.py) ---
# How far a held position must move against itself, over the monitor's
# 5-day window, before it proposes closing mid-week. An emergency brake,
# not a second opinion: the weekly hold rules decide when a position has
# run its course, and this exists only so a Tuesday collapse isn't found
# the following Monday. ~4% is one week of ordinary movement for a typical
# S&P 500 name, so anything near that fires on noise, hourly, against a
# thesis that needs ~20 trading days. 0.11 is roughly three standard
# deviations. Quiet is the intended state.
CONTRADICTION_MOMENTUM_PCT=0.11

# --- Data freshness ---
# The weekly cycle aborts (and alerts) instead of trading if the newest
# price or feature row is older than this many days.
MAX_DATA_STALENESS_DAYS=3

# --- Risk limits (defaults; override per-environment, not per-trade) ---
MAX_DRAWDOWN_PCT=0.15
# Conservative defaults sized for the diversified book (the default
# strategy). Running STRATEGY_MODE=concentrated? Raise these so the
# circuit breakers sit above the strategy's intended ~70% single-name
# deployment instead of tripping on normal operation:
#   MAX_SINGLE_POSITION_PCT=0.80
#   MAX_CORRELATED_EXPOSURE_PCT=0.95
MAX_SINGLE_POSITION_PCT=0.25
# Shorts are sized more conservatively than longs by default in the
# diversified path — a short's loss is structurally uncapped, a long's isn't.
MAX_SHORT_POSITION_PCT=0.15
MAX_CORRELATED_EXPOSURE_PCT=0.50

# --- Prediction target ---
# absolute = each stock's raw forward return (the original). Dominated by
#            market drift, which the model was then credited with as skill.
# relative = cross-sectional excess: forward return minus the equal-weight
#            mean forward return of the universe on the same date. Features
#            are z-scored per date to match, so the model ranks stocks
#            against same-day peers. Default.
TARGET_MODE=relative

# --- Direction ---
# May the screener propose short candidates at all?
# Off by default on the evidence: in the 10-fold walk-forward, shorts paid
# -1.069% per trade at a 41.6% win rate vs +0.225% / 52.1% for longs.
# Short candidates are dropped before sizing, not sized to zero. The code
# path is intact — set true to re-enable if shorts ever earn it.
ALLOW_SHORTS=false

# --- Strategy selection ---
# diversified (default) = top-k book under the conservative caps above
# concentrated = 2-trade high-conviction split (see caps note above)
STRATEGY_MODE=diversified
SCREENER_TOP_K=10
# Scale the diversified book up to ~100% allocated (caps still bind).
# Off by default — being fully invested is a risk-appetite decision.
FULL_DEPLOYMENT=false

# --- Concentrated 2-trade strategy (models.screener.select_concentrated_trades) ---
# Full deployable capital is split between the top 2 highest-conviction
# picks, weighted by relative confidence, bounded so the dominant leg can't
# swallow the whole deployment. MIN should be 1 - MAX.
MAX_CONCENTRATED_POSITION_PCT=0.70
MIN_CONCENTRATED_POSITION_PCT=0.30
