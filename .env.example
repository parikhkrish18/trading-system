# --- Broker selection ---
# ibkr  = Interactive Brokers via locally running TWS / IB Gateway (recommended)
# alpaca = Alpaca REST API (needs keys below)
BROKER=ibkr

# Which trading environment to use. NEVER default to live.
TRADING_MODE=paper

# Outside RTH, market orders aren't accepted at all — when true,
# execution/broker_alpaca.py switches to limit orders automatically.
# IBKR (execution/broker_ibkr.py) doesn't support this yet.
ALLOW_EXTENDED_HOURS_TRADING=true

# --- IBKR (TWS / IB Gateway) ---
# No API keys — log in to TWS/Gateway and enable socket API access.
# Ports match Blue_Chip_Trading_Bot/tws_bot.py:
#   TWS paper 7497 | TWS live 7496
#   IBG paper 4002 | IBG live 4001
IBKR_HOST=127.0.0.1
IBKR_CLIENT_ID=1
IBKR_LIVE_CLIENT_ID=2
IBKR_PAPER_PORT=7497
IBKR_LIVE_PORT=7496

# --- Broker (Alpaca) — only needed when BROKER=alpaca ---
# Keep paper and live keys in clearly separate variables so a bug can't
# fire a live order during a paper test (see Security section of the plan).
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# --- Market data vendor(s) ---
# Alpaca's own market data feed works out of the box with the keys above.
# Set these if you're using a separate consolidated-tape / fundamentals+news
# vendor (e.g. Polygon). Used by data/ingest/fundamentals.py and
# data/ingest/news.py.
POLYGON_API_KEY=
FUNDAMENTALS_NEWS_API_KEY=

# --- LLM (used by features/qualitative/sentiment.py for headline scoring) ---
ANTHROPIC_API_KEY=

# --- FRED (CPI/Jobs release dates for data/ingest/macro_calendar.py) ---
# Free instant key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Database (TimescaleDB via docker-compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=trading
DB_PASSWORD=change_me_locally

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Dashboard (HTTP Basic Auth) ---
# Required when the dashboard is bound to anything but localhost; with it
# empty the server refuses non-loopback requests rather than serving openly.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Alerts ---
SLACK_WEBHOOK_URL=

# --- Risk limits (defaults; override per-environment, not per-trade) ---
MAX_DRAWDOWN_PCT=0.15
# Circuit-breaker-only thresholds — the active strategy (concentrated 2-trade,
# see MAX/MIN_CONCENTRATED_POSITION_PCT below) legitimately deploys up to 70%
# into one name, so these sit above that as a genuine last-line-of-defense,
# not a sizing cap. Only the legacy diversified-book path in risk/sizing.py
# still treats MAX_SINGLE_POSITION_PCT/MAX_SHORT_POSITION_PCT as sizing caps.
MAX_SINGLE_POSITION_PCT=0.80
# Shorts are sized more conservatively than longs by default in the legacy
# path — a short's loss is structurally uncapped, a long's isn't.
MAX_SHORT_POSITION_PCT=0.15
MAX_CORRELATED_EXPOSURE_PCT=0.95

# --- Concentrated 2-trade strategy (models.screener.select_concentrated_trades) ---
# Full deployable capital is split between the top 2 highest-conviction
# picks, weighted by relative confidence, bounded so the dominant leg can't
# swallow the whole deployment. MIN should be 1 - MAX.
MAX_CONCENTRATED_POSITION_PCT=0.70
MIN_CONCENTRATED_POSITION_PCT=0.30
